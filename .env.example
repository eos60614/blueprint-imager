# Blueprint Imager Backend Configuration

# AWS S3 (required for file uploads)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-2
S3_BUCKET_NAME=dwg-sets

# CORS - Add your Vercel frontend URL (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# PDF Processing (optional - these are defaults)
PDF_DPI=600
TILE_SIZE=1920
TILE_OVERLAP=250

# Local storage
LOCAL_TILE_STORAGE_PATH=/var/data/tiles
TILE_TTL_HOURS=24

# Roboflow (optional)
ROBOFLOW_API_KEY=
ROBOFLOW_PROJECT_NAME=

# Procore (optional)
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=
PROCORE_API_BASE_URL=https://sandbox.procore.com
PROCORE_AUTH_BASE_URL=https://login-sandbox.procore.com
PROCORE_COMPANY_ID=
