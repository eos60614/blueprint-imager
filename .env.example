# PostgreSQL Database
DATABASE_HOST=your-rds-endpoint.region.rds.amazonaws.com
DATABASE_PORT=5432
DATABASE_NAME=blueprint_imager
DATABASE_USER=your_db_user
DATABASE_PASSWORD=your_db_password

# AWS S3
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=us-east-2
S3_BUCKET_NAME=your-bucket-name

# PDF Processing
PDF_DPI=600
TILE_SIZE=1920
TILE_OVERLAP=250

# Upload limits
MAX_FILE_SIZE=524288000

# Procore
PROCORE_CLIENT_ID=your_client_id
PROCORE_CLIENT_SECRET=your_client_secret
PROCORE_API_BASE_URL=https://sandbox.procore.com
PROCORE_AUTH_BASE_URL=https://login-sandbox.procore.com
PROCORE_COMPANY_ID=your_company_id

# CORS
CORS_ORIGINS=http://localhost:3000,https://*.vercel.app

# Roboflow (for uploading tiles to Roboflow datasets)
ROBOFLOW_API_KEY=your_roboflow_api_key
ROBOFLOW_PROJECT_NAME=your_project_name
